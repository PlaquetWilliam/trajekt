# Copiez ce fichier en .env.local (jamais commité) et remplissez les valeurs.

# Chaîne de connexion MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI="mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="trajekt"

# URL publique du site (sert au SEO : balises canoniques, sitemap)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
